extends SceneTree
## Balance report: plays whole seeded runs with the simulated player (Bot) at each skill tier
## and reports where runs end, each stage's clear rate and time, and how much each upgrade helps.
##   dev -Balance                       20 runs per tier, seeds from 1000
##   dev -Balance --runs=50 --seed=1 --tiers=average,expert --out=docs/balance-latest.md
##   dev -Balance --real                adds your own unstaged runs from the game's run log
##   dev -Balance --no-upgrades         never picks an upgrade
##   dev -Balance --strength            upgrade strength: the same seeds played as normal runs,
##                                      then holding each upgrade (3 stacks if it stacks) from
##                                      the start; average tier unless --tiers names one;
##                                      --only=id,id limits it to some upgrades
##
## The bot picks upgrades at random, so "lift" (how much more often a stage is cleared with the
## upgrade held, comparing like stages) isn't skewed by its taste. Numbers tuned on the bot are
## provisional until real runs agree with them.

## A stage that runs this long in game time is counted as a stall (the bot gave up).
const STAGE_TIME_CAP := 600.0
const RUN_LOG := "user://runs.jsonl"

var _runs := 20
var _seed := 1000
var _tiers: Array[String] = ["random", "novice", "average", "expert"]
var _out := ""
var _real := false
## Skip every upgrade pick, to see how much the upgrades carry a run.
var _no_upgrades := false
var _strength := false
## Upgrade ids the strength report is limited to (all when empty).
var _only: PackedStringArray = []

## Per tier: list of run summaries (Run.summary() plus "stalled", "minutes", "bot").
var _results := {}
var _offered := {}
var _picked := {}


func _initialize() -> void:
	for arg in OS.get_cmdline_user_args():
		var parts := arg.trim_prefix("--").split("=")
		match parts[0]:
			"runs": _runs = parts[1].to_int()
			"seed": _seed = parts[1].to_int()
			"tiers": _tiers.assign(parts[1].split(","))
			"out": _out = parts[1]
			"real": _real = true
			"no-upgrades": _no_upgrades = true
			"strength": _strength = true
			"only": _only = parts[1].split(",")
	var started := Time.get_ticks_msec()
	if _strength:
		_write(_strength_report(_tiers[0] if _tiers.size() == 1 else "average", started))
		quit()
		return
	for tier in _tiers:
		_results[tier] = []
		for i in _runs:
			var tick := Time.get_ticks_msec()
			var result := _play(tier, _seed + i)
			_results[tier].append(result)
			print("%-8s seed %d: %s, %.1f game min, %.1f s" % [tier, _seed + i,
				"won" if result["victory"] else "lost on stage %d%s" % [result["stage"], " (stall)" if result["stalled"] else ""],
				result["minutes"], (Time.get_ticks_msec() - tick) / 1000.0])
	if _real:
		_results["real"] = _load_real_runs()
	_write(_report((Time.get_ticks_msec() - started) / 1000.0))
	quit()


func _write(report: String) -> void:
	print("\n" + report)
	if _out == "":
		return
	var file := FileAccess.open(_out if _out.contains("://") else "res://" + _out, FileAccess.WRITE)
	if file:
		file.store_string(report)
		print("Wrote " + _out)
	else:
		printerr("Couldn't write " + _out)


## Plays the same seeds with no upgrades and then with each upgrade alone, held from the start.
func _strength_report(tier: String, started: int) -> String:
	var variants: Array = [{"name": "None held", "upgrades": {}}]
	for upgrade in Upgrades.ALL:
		if not _only.is_empty() and not _only.has(upgrade["id"]):
			continue
		var stacks := mini(upgrade["max"], 3)
		variants.append({"name": upgrade["name"] + (" ×%d" % stacks if stacks > 1 else ""), "upgrades": {upgrade["id"]: stacks}})
	var rows: Array = []
	var baseline := 0.0
	for variant in variants:
		var reached := 0.0
		var wins := 0
		var attempts := 0
		var lost := 0
		for i in _runs:
			var result := _play(tier, _seed + i, variant["upgrades"])
			reached += 13 if result["victory"] else result["stage"]
			wins += 1 if result["victory"] else 0
			for entry in result["stages"]:
				attempts += 1
				lost += int(entry["lives_lost"])
		var mean := reached / _runs
		if variant["upgrades"].is_empty():
			baseline = mean
		rows.append([mean, "| %s | %.1f | %+.1f | %s | %.2f |" % [variant["name"], mean, mean - baseline, _pct(wins, _runs), float(lost) / maxi(attempts, 1)]])
		print("%-20s mean stage %.1f, wins %d" % [variant["name"], mean, wins])
	var lines: Array[String] = ["# Upgrade strength", "",
		"The %s bot plays %d seeds (%d to %d) as normal runs with random picks: first as they are, then holding one upgrade (3 stacks if it stacks) from stage 1. Every variant plays the same seeds, so the differences are paired. Mean stage reached counts a win as 13. Took %.0f s. Generated by `dev -Balance --strength`." % [tier, _runs, _seed, _seed + _runs - 1, (Time.get_ticks_msec() - started) / 1000.0],
		"", "| Held from the start | Mean stage reached | vs none held | Wins | Lives lost per stage |", "| --- | --- | --- | --- | --- |"]
	rows.sort_custom(func(a: Array, b: Array) -> bool: return a[0] > b[0])
	for row in rows:
		lines.append(row[1])
	lines.append("")
	return "\n".join(lines)


func _play(tier: String, seed_value: int, start_upgrades := {}) -> Dictionary:
	var run := Run.new(seed_value)
	run.upgrades = start_upgrades.duplicate()
	run.lives += run.stacks("spare")

	var bot := Bot.new(tier, seed_value * 7919 + 17)
	var picker := RandomNumberGenerator.new()
	picker.seed = seed_value * 104729 + 3
	var minutes := 0.0
	while true:
		var board := run.start_stage()
		bot.begin(board)
		var stalled := false
		while board.state == Board.State.PLAYING:
			board.step()
			for event in board.take_events():
				run.handle_event(event)
			bot.update()
			if board.time > STAGE_TIME_CAP:
				stalled = true
				break
		minutes += board.time / 60.0
		if board.state != Board.State.CLEARED:
			run.fail_stage()
			return _summary(run, false, stalled, minutes, bot)
		run.finish_stage()
		if run.is_final_stage():
			return _summary(run, true, false, minutes, bot)
		if _no_upgrades:
			run.pending_levels = 0
		while run.pending_levels > 0:
			run.open_offer()
			if run.offer.is_empty():
				run.pending_levels = 0
				break
			for id in run.offer:
				_offered[id] = _offered.get(id, 0) + 1
			var id := run.pick(picker.randi() % run.offer.size())
			_picked[id] = _picked.get(id, 0) + 1
		run.advance()
	return {}


func _summary(run: Run, victory: bool, stalled: bool, minutes: float, bot: Bot) -> Dictionary:
	var result := run.summary(victory)
	result["stalled"] = stalled
	result["minutes"] = minutes
	result["bot"] = {"clicks": bot.clicks, "actives": bot.actives_used, "gambles": bot.gambles}
	return result


## Your own finished runs from the game's log, without staged starts, last entry per seed.
func _load_real_runs() -> Array:
	var by_seed := {}
	var file := FileAccess.open(RUN_LOG, FileAccess.READ)
	if file == null:
		return []
	while not file.eof_reached():
		var line := file.get_line().strip_edges()
		if line == "":
			continue
		var entry = JSON.parse_string(line)
		if entry is Dictionary and not entry.get("staged", false):
			var minutes := 0.0
			for stage in entry["stages"]:
				minutes += stage["time"] / 60.0
			entry["minutes"] = minutes
			entry["stalled"] = false
			entry["stage"] = int(entry["stage"])
			by_seed[entry["seed"]] = entry
	return by_seed.values()


# --- Report --------------------------------------------------------------------------------------

func _report(seconds: float) -> String:
	var tiers: Array = _results.keys()
	var lines: Array[String] = []
	lines.append("# Balance report")
	lines.append("")
	lines.append("%d runs per bot tier, seeds %d to %d. Stage cap %d s. Took %.0f s. Generated by `dev -Balance`." % [_runs, _seed, _seed + _runs - 1, STAGE_TIME_CAP, seconds])
	lines.append("")
	lines.append("## Runs")
	lines.append("")
	lines.append("| Tier | Runs | Wins | Median stage reached | Reached 6+ | Upgrades per run | Game minutes per run | Stalls | Actives used | Gambles |")
	lines.append("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
	for tier in tiers:
		var runs: Array = _results[tier]
		if runs.is_empty():
			lines.append("| %s | 0 | | | | | | | | |" % tier)
			continue
		var reached: Array[int] = []
		var wins := 0
		var six := 0
		var stalls := 0
		var minutes := 0.0
		var actives := 0
		var gambles := 0
		var picks := 0
		for result in runs:
			for id in result["upgrades"]:
				picks += int(result["upgrades"][id])
			reached.append(13 if result["victory"] else result["stage"])
			wins += 1 if result["victory"] else 0
			six += 1 if result["victory"] or result["stage"] >= 6 else 0
			stalls += 1 if result["stalled"] else 0
			minutes += result["minutes"]
			if result.has("bot"):
				actives += result["bot"]["actives"]
				gambles += result["bot"]["gambles"]
		reached.sort()
		var median := reached[reached.size() / 2]
		lines.append("| %s | %d | %s | %s | %s | %.1f | %.1f | %d | %d | %d |" % [tier, runs.size(), _pct(wins, runs.size()),
			"won" if median == 13 else str(median), _pct(six, runs.size()), float(picks) / runs.size(), minutes / runs.size(), stalls, actives, gambles])

	lines.append("")
	lines.append("## Where runs end")
	lines.append("")
	lines.append("Runs lost on each stage; W is won.")
	lines.append("")
	var header := "| Tier |"
	var rule := "| --- |"
	for stage in range(1, StageTable.count() + 1):
		header += " %d |" % stage
		rule += " --- |"
	lines.append(header + " W |")
	lines.append(rule + " --- |")
	for tier in tiers:
		var ends := {}
		for result in _results[tier]:
			var key = "W" if result["victory"] else result["stage"]
			ends[key] = ends.get(key, 0) + 1
		var row := "| %s |" % tier
		for stage in range(1, StageTable.count() + 1):
			row += " %s |" % (str(ends[stage]) if ends.has(stage) else "")
		lines.append(row + " %s |" % (str(ends["W"]) if ends.has("W") else ""))

	lines.append("")
	lines.append("## Stages")
	lines.append("")
	lines.append("Clear rate of the attempts that reached the stage, then for clears: median seconds and walls; then lives lost per attempt.")
	lines.append("")
	header = "| Stage |"
	rule = "| --- |"
	for tier in tiers:
		header += " %s |" % tier
		rule += " --- |"
	lines.append(header)
	lines.append(rule)
	for stage in range(1, StageTable.count() + 1):
		var row := "| %d |" % stage
		for tier in tiers:
			var attempts := 0
			var cleared := 0
			var lost := 0
			var times: Array[float] = []
			var walls: Array[int] = []
			for result in _results[tier]:
				for entry in result["stages"]:
					if int(entry["stage"]) != stage:
						continue
					attempts += 1
					lost += int(entry["lives_lost"])
					if entry["cleared"]:
						cleared += 1
						times.append(float(entry["time"]))
						walls.append(int(entry["walls"]))
			if attempts == 0:
				row += " |"
				continue
			times.sort()
			walls.sort()
			var median := "%d s, %d walls" % [roundi(times[times.size() / 2]), walls[walls.size() / 2]] if not times.is_empty() else "–"
			row += " %s of %d, %s, %.1f |" % [_pct(cleared, attempts), attempts, median, float(lost) / attempts]
		lines.append(row)

	lines.append("")
	lines.append("## Upgrades")
	lines.append("")
	lines.append("Bot tiers pooled (not random), comparing attempts at the same stage with the upgrade held and without. Clear lift: points more often cleared. Lives saved: fewer lives lost per stage. – when too few attempts to compare.")
	lines.append("")
	lines.append("| Upgrade | Offered | Picked | Clear lift | Lives saved |")
	lines.append("| --- | --- | --- | --- | --- |")
	var lifts := _lifts()
	var rows: Array = []
	for upgrade in Upgrades.ALL:
		var id: String = upgrade["id"]
		var lift: Array = lifts.get(id, [])
		rows.append([lift[1] if lift else -INF, "| %s | %d | %d | %s | %s |" % [upgrade["name"], _offered.get(id, 0), _picked.get(id, 0),
			"%+.0f" % (lift[0] * 100.0) if lift else "–", "%+.2f" % lift[1] if lift else "–"]])
	rows.sort_custom(func(a: Array, b: Array) -> bool: return a[0] > b[0])
	for row in rows:
		lines.append(row[1])
	lines.append("")
	return "\n".join(lines)


## Per upgrade, [clear rate lift, lives saved per stage]: stage-matched differences with and
## without it, weighted per stage by the smaller of the two groups.
func _lifts() -> Dictionary:
	var counts := {}  # id -> stage -> [with_n, with_cleared, with_lost, without_n, without_cleared, without_lost]
	for tier in _results:
		if tier == "random" or tier == "real":
			continue
		for result in _results[tier]:
			for entry in result["stages"]:
				var stage := int(entry["stage"])
				var held: Array = entry.get("upgrades", [])
				for upgrade in Upgrades.ALL:
					var id: String = upgrade["id"]
					if not counts.has(id):
						counts[id] = {}
					if not counts[id].has(stage):
						counts[id][stage] = [0, 0, 0, 0, 0, 0]
					var cell: Array = counts[id][stage]
					var offset := 0 if held.has(id) else 3
					cell[offset] += 1
					cell[offset + 1] += 1 if entry["cleared"] else 0
					cell[offset + 2] += int(entry["lives_lost"])
	var lifts := {}
	for id in counts:
		var weight := 0.0
		var clear := 0.0
		var saved := 0.0
		for stage in counts[id]:
			var cell: Array = counts[id][stage]
			var w := float(mini(cell[0], cell[3]))
			if w <= 0.0:
				continue
			weight += w
			clear += w * (float(cell[1]) / cell[0] - float(cell[4]) / cell[3])
			saved += w * (float(cell[5]) / cell[3] - float(cell[2]) / cell[0])
		if weight >= 5.0:
			lifts[id] = [clear / weight, saved / weight]
	return lifts


static func _pct(part: int, whole: int) -> String:
	return "%d%%" % roundi(100.0 * part / whole) if whole > 0 else "–"
